# Copy to .env.local and fill in. Never commit .env.local.
# Cloudinary Console → Settings → API Keys → copy "API environment variable".
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=<cloud_name>

# Generation mode: mock in dev/tests (0 credits), live only in production. See Budget Lock.
GEN_MODE=mock
LIVE_AI=off
LIVE_UPLOADS=on

# Random long strings (e.g. `node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"`).
SESSION_SECRET=
CRON_SECRET=
